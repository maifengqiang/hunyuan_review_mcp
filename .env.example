# 复制成 .env 后填真实值：cp .env.example .env
# .env 已被 .gitignore 排除，不会进版本库。
# 优先级：真实环境变量 > 本文件 > 代码默认值。

# ── 必填 ───────────────────────────────────────────────
# 腾讯云控制台 → 搜「混元大模型」→ 开通 → API Key 管理 → 创建
# 密钥只显示一次，丢了只能重建。
HUNYUAN_API_KEY=在此粘贴你的key

# ── 模型选择 ───────────────────────────────────────────
# hunyuan-t1-latest      深度推理，评审默认。挑逻辑漏洞最狠，慢且贵
# hunyuan-turbos-latest  常规快审，日常够用，成本低
# hunyuan-lite           永久免费额度，适合大批量粗筛
HUNYUAN_MODEL=hunyuan-t1-latest

# ── 项目定位 ───────────────────────────────────────────
# 仓库根绝对路径。C++ 评审必须指到有 CMakeLists.txt 的那一层。
PROJECT_ROOT=/path/to/your/cpp/repo
# 增量 diff 的参照分支，改 main / master 按你们实际来
GIT_BASE=main

# ── 循环与超时 ─────────────────────────────────────────
# 打回重做的轮次上限。2 是甜蜜点，第 3 轮开始只是加噪声烧钱。
MAX_ROUND=2
# 单次评审超时（秒）。t1 深度推理慢，别设太短。
REVIEW_TIMEOUT=600
# 混元默认 5 并发且主子账号共享，重试次数不要调到 0。
HY_RETRY=4

# ── 证据采集 ───────────────────────────────────────────
# 编译闸门超时。C++ 全量构建给足时间。
EVIDENCE_TIMEOUT=900
# 整体采集上限。只跑 plain 时 600 够；加 asan+tsan 建议 2400。
# EVIDENCE_TOTAL=2400
# 单条证据保留的输出尾部行数与字节上限，防撑爆上下文。
EVIDENCE_TAIL=120
EVIDENCE_MAXBYTES=24000

# ── 服务监听 ───────────────────────────────────────────
PORT=8080
# 只听本机。改成 0.0.0.0 之前先读 README 的「安全」一节：
# 这个口子上的工具能以你的身份跑 cmake 和编译器，绝不能裸奔到公网。
BIND=127.0.0.1

# ── 判据文件 ───────────────────────────────────────────
# 缺省用同级 CHECKS.md；想给不同项目配不同标准就指过去。
# CHECKS_PATH=/abs/path/to/CHECKS.md
